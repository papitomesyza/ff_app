# Server port. Defaults to 3000 if unset.
PORT=3000

# Where the SQLite file lives. Matches the Zeabur volume mount by default.
DATA_DIR=/app/data

# The single-user login passphrase. This is authoritative: on every boot, if
# it differs from what was last synced, the login hash is updated to match.
# A passphrase changed later from the Settings screen is NOT overwritten by
# this var unless you also change APP_PASSPHRASE itself.
# Required (and must not be "change-me" / "change-me-flow") when
# NODE_ENV=production — the server refuses to start otherwise.
APP_PASSPHRASE=change-me

# Secret used to sign session tokens and to fingerprint APP_PASSPHRASE.
# Required (and must not be the dev default) when NODE_ENV=production.
SESSION_SECRET=change-this-to-a-long-random-string
